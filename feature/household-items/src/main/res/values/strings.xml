    <!-- AI 工具:add_household_item -->
    <string name="agent_tool_add_household_item_title">Add Item</string>
    <string name="agent_tool_add_household_item_summary">Record an item with its storage location</string>
    <string name="agent_tool_add_household_item_description">Record an item: name, storage location path, optional category, expiry date and note. Existing same-name locations (even nested ones) are reused; missing levels are created automatically.</string>
