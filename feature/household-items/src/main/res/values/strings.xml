    <string name="agent_tool_add_household_item_param_location_path">Storage location path, segments separated by "/" or "&gt;", e.g. "Home/Bedroom/Medicine box". Existing same-name locations are reused; missing ones are created</string>
    <string name="agent_tool_add_household_item_param_category">Category, free text, e.g. Medicine / Small items / Large items</string>
    <string name="agent_tool_add_household_item_param_expire_date">Expiry date, yyyy-MM-dd, optional</string>
    <string name="agent_tool_add_household_item_param_note">Optional note</string>
    <string name="agent_tool_add_household_item_failed">Failed to add item: %1$s</string>
    <string-array name="agent_tool_add_household_item_keywords">
        <item>household</item>
        <item>item</item>
        <item>storage</item>
        <item>add item</item>
    </string-array>
