    <string name="agent_tool_add_household_item_param_location_path">Ruta de ubicación, segmentos separados por "/" o "&gt;", ej. "Casa/Dormitorio/Botiquín". Las ubicaciones existentes con el mismo nombre se reutilizan; las que falten se crean</string>
    <string name="agent_tool_add_household_item_param_category">Categoría, texto libre, p. ej. Medicamentos / Artículos pequeños / Artículos grandes</string>
    <string name="agent_tool_add_household_item_param_expire_date">Fecha de caducidad, aaaa-MM-dd, opcional</string>
    <string name="agent_tool_add_household_item_param_note">Nota opcional</string>
