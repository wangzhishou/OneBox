    <!-- Agent 工具:add_health_record -->
    <string name="agent_tool_add_health_record_title">Gesundheitseintrag hinzufügen</string>
    <string name="agent_tool_add_health_record_summary">Einen Gesundheitswert wie Blutdruck oder Gewicht erfassen</string>
    <string name="agent_tool_add_health_record_description">Gesundheitseinträge hinzufügen. Einzelmodus: record_type und values auf oberster Ebene übergeben (optional happened_at/note). Batch-Modus: records-Array übergeben, um mehrere Einträge auf einmal hinzuzufügen; jedes Element hat dieselben Felder und wird unabhängig verarbeitet, sodass Teilausfälle den Rest nicht beeinträchtigen. values muss ein JSON-Objekt sein, das Feldschlüssel auf Zahlen abbildet; Feldschlüssel und Einheiten hängen von record_type ab. Unterstützte Eintragstypen und ihre Felder:</string>
    <string name="agent_tool_add_health_record_param_records">Batch-Modus: Array von Eintragselementen, jeweils mit record_type und values (optional happened_at/note). Wenn vorhanden, werden record_type/values auf oberster Ebene ignoriert</string>
    <string name="agent_tool_add_health_record_param_record_type">Eintragstyp-Schlüssel, einer der Enum-Werte</string>
    <string name="agent_tool_add_health_record_param_values">Feldwerte als JSON-Objekt, das Feldschlüssel auf Zahlen abbildet, z. B. {\"systolic\": 120, \"diastolic\": 80}</string>
    <string name="agent_tool_add_health_record_param_happened_at">Zeitpunkt der Messung in Epoch-Millisekunden; Standard ist jetzt</string>
