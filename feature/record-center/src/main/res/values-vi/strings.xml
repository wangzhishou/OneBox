    <string name="agent_tool_add_health_record_summary">Ghi lại huyết áp, nhịp tim, cân nặng và các dữ liệu sức khỏe khác</string>
    <string name="agent_tool_add_health_record_description">Thêm bản ghi sức khỏe. Chế độ đơn: truyền record_type và values ở cấp cao nhất (tùy chọn happened_at/note). Chế độ hàng loạt: truyền mảng records để thêm nhiều bản ghi cùng lúc, mỗi mục có các trường như chế độ đơn, mỗi mục được xử lý độc lập, lỗi một phần không ảnh hưởng đến các mục khác. values là đối tượng JSON dạng tên_trường→giá_trị, tên trường và đơn vị do record_type quyết định. Các loại bản ghi và trường được hỗ trợ:</string>
    <string name="agent_tool_add_health_record_param_records">Chế độ hàng loạt: mảng bản ghi, mỗi mục gồm record_type và values (tùy chọn happened_at/note); khi truyền vào sẽ bỏ qua record_type/values ở cấp cao nhất</string>
    <string name="agent_tool_add_health_record_param_record_type">Loại bản ghi, chọn một trong các giá trị enum</string>
    <string name="agent_tool_add_health_record_param_values">Giá trị trường, đối tượng JSON dạng tên_trường→giá_trị, ví dụ {\"systolic\": 120, \"diastolic\": 80}</string>
    <string name="agent_tool_add_health_record_param_happened_at">Dấu thời gian mili giây khi đo, mặc định là thời gian hiện tại</string>
