    <!-- Agent 工具:add_health_record -->
    <string name="agent_tool_add_health_record_title">Add Health Record</string>
    <string name="agent_tool_add_health_record_summary">Record a health metric such as blood pressure or weight</string>
    <string name="agent_tool_add_health_record_description">Add health records. Single mode: pass record_type and values at the top level (optional happened_at/note). Batch mode: pass a records array to add multiple records at once; each item takes the same fields, and items are processed independently so partial failures do not affect the rest. values must be a JSON object mapping field keys to numbers; field keys and units depend on record_type. Supported record types and their fields:</string>
    <string name="agent_tool_add_health_record_param_records">Batch mode: array of record items, each with record_type and values (optional happened_at/note). When present, top-level record_type/values are ignored</string>
    <string name="agent_tool_add_health_record_param_record_type">Record type key, one of the enum values</string>
    <string name="agent_tool_add_health_record_param_values">Field values as a JSON object mapping field keys to numbers, e.g. {\"systolic\": 120, \"diastolic\": 80}</string>
    <string name="agent_tool_add_health_record_param_happened_at">When the measurement happened, epoch milliseconds; defaults to now</string>
    <string name="agent_tool_add_health_record_param_note">Optional note</string>
    <string name="agent_tool_add_health_record_success">Saved</string>
    <string name="agent_tool_add_health_record_failed">Failed to add health record: %1$s</string>
    <string name="agent_tool_add_health_record_batch_empty">records must not be empty</string>
    <string name="agent_tool_add_health_record_batch_success_count">%1$d succeeded</string>
    <string name="agent_tool_add_health_record_batch_failure_count">%1$d failed</string>
    <string name="agent_tool_add_health_record_batch_section_success">Saved records</string>
    <string name="agent_tool_add_health_record_batch_section_failure">Failed records</string>
