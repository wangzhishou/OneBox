    <!-- Agent 工具:add_health_record -->
    <string name="agent_tool_add_health_record_title">Magdagdag ng Rekord ng Kalusugan</string>
    <string name="agent_tool_add_health_record_summary">Magtala ng sukatan ng kalusugan tulad ng presyon ng dugo o timbang</string>
    <string name="agent_tool_add_health_record_description">Magdagdag ng mga rekord ng kalusugan. Single mode: ipasa ang record_type at values sa top level (opsyonal ang happened_at/note). Batch mode: ipasa ang records array upang magdagdag ng maraming rekord nang sabay-sabay; parehong mga field ang bawat item at hiwalay na pinoproseso ang bawat isa, kaya hindi naaapektuhan ng bahagyang pagkabigo ang iba. Ang values ay dapat JSON object na nagmamapa ng mga field key sa mga numero; ang mga field key at unit ay nakadepende sa record_type. Mga suportadong uri ng rekord at ang kanilang mga field:</string>
    <string name="agent_tool_add_health_record_param_records">Batch mode: array ng mga item ng rekord, bawat isa ay may record_type at values (opsyonal ang happened_at/note). Kapag narito, binabalewala ang top-level record_type/values</string>
    <string name="agent_tool_add_health_record_param_record_type">Key ng uri ng rekord, isa sa mga enum value</string>
    <string name="agent_tool_add_health_record_param_values">Mga field value bilang JSON object na nagmamapa ng mga field key sa mga numero, hal. {\"systolic\": 120, \"diastolic\": 80}</string>
    <string name="agent_tool_add_health_record_param_happened_at">Kailan naganap ang pagsukat, epoch milliseconds; default ay ngayon</string>
    <string name="agent_tool_add_health_record_param_note">Opsyonal na tala</string>
    <string name="agent_tool_add_health_record_success">Nai-save na</string>
    <string name="agent_tool_add_health_record_failed">Nabigong magdagdag ng rekord ng kalusugan: %1$s</string>
