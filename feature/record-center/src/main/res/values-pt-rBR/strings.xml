    <!-- Agent 工具:add_health_record -->
    <string name="agent_tool_add_health_record_title">Adicionar Registro de Saúde</string>
    <string name="agent_tool_add_health_record_summary">Registre uma métrica de saúde como pressão arterial ou peso</string>
    <string name="agent_tool_add_health_record_description">Adicione registros de saúde. Modo único: passe record_type e values no nível superior (happened_at/note opcionais). Modo em lote: passe um array records para adicionar vários registros de uma vez; cada item usa os mesmos campos e é processado de forma independente, portanto falhas parciais não afetam os demais. values deve ser um objeto JSON que mapeia chaves de campo para números; as chaves e unidades dependem de record_type. Tipos de registro suportados e seus campos:</string>
    <string name="agent_tool_add_health_record_param_records">Modo em lote: array de itens de registro, cada um com record_type e values (happened_at/note opcionais). Quando presente, record_type/values do nível superior são ignorados</string>
    <string name="agent_tool_add_health_record_param_record_type">Chave do tipo de registro, um dos valores do enum</string>
    <string name="agent_tool_add_health_record_param_values">Valores de campo como objeto JSON que mapeia chaves para números, ex. {\"systolic\": 120, \"diastolic\": 80}</string>
    <string name="agent_tool_add_health_record_param_happened_at">Quando a medição ocorreu, em milissegundos epoch; o padrão é agora</string>
    <string name="agent_tool_add_health_record_param_note">Nota opcional</string>
    <string name="agent_tool_add_health_record_success">Salvo</string>
    <string name="agent_tool_add_health_record_failed">Falha ao adicionar registro de saúde: %1$s</string>
    <string name="agent_tool_add_health_record_batch_empty">records não pode estar vazio</string>
    <string name="agent_tool_add_health_record_batch_success_count">%1$d com sucesso</string>
    <string name="agent_tool_add_health_record_batch_failure_count">%1$d com falha</string>
