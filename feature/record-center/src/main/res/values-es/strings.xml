    <!-- Agent 工具:add_health_record -->
    <string name="agent_tool_add_health_record_title">Añadir registro de salud</string>
    <string name="agent_tool_add_health_record_summary">Registra una métrica de salud como la presión arterial o el peso</string>
    <string name="agent_tool_add_health_record_description">Añade registros de salud. Modo individual: pasa record_type y values en el nivel superior (happened_at/note opcionales). Modo por lotes: pasa un array records para añadir varios registros a la vez; cada elemento usa los mismos campos y se procesa de forma independiente, por lo que los fallos parciales no afectan al resto. values debe ser un objeto JSON que asocia claves de campo con números; las claves y unidades dependen de record_type. Tipos de registro admitidos y sus campos:</string>
    <string name="agent_tool_add_health_record_param_records">Modo por lotes: array de elementos de registro, cada uno con record_type y values (happened_at/note opcionales). Si está presente, se ignoran record_type/values del nivel superior</string>
    <string name="agent_tool_add_health_record_param_record_type">Clave del tipo de registro, uno de los valores del enum</string>
    <string name="agent_tool_add_health_record_param_values">Valores de campo como objeto JSON que asocia claves con números, p. ej. {\"systolic\": 120, \"diastolic\": 80}</string>
    <string name="agent_tool_add_health_record_param_happened_at">Cuándo se realizó la medición, en milisegundos epoch; por defecto, ahora</string>
    <string name="agent_tool_add_health_record_param_note">Nota opcional</string>
    <string name="agent_tool_add_health_record_success">Guardado</string>
    <string name="agent_tool_add_health_record_failed">No se pudo añadir el registro de salud: %1$s</string>
    <string name="agent_tool_add_health_record_batch_empty">records no debe estar vacío</string>
    <string name="agent_tool_add_health_record_batch_success_count">%1$d correctos</string>
    <string name="agent_tool_add_health_record_batch_failure_count">%1$d fallidos</string>
