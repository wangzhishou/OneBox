    <string name="ai_feature_settings_heading">Interruptores de funciones de IA</string>
    <string name="ai_feature_settings_desc">Administre de forma centralizada los interruptores de preferencias utilizados en las conversaciones de IA. Los futuros interruptores relacionados con IA se recopilarán aquí.</string>
    <string name="ai_feature_settings_toggle_section_title">Preferencias de conversación</string>
    <string name="ai_feature_settings_toggle_section_desc">Controle los comportamientos automatizados y las preferencias de funciones para la experiencia de conversación con IA.</string>
    <string name="ai_feature_settings_title_summary_toggle_title">Generar títulos de historial automáticamente</string>
    <string name="ai_feature_settings_title_summary_toggle_desc">Después de guardar la primera pregunta y respuesta, se crea automáticamente un título resumido generado por IA para la conversación. Cuando está desactivado, se mantiene el título predeterminado o el título del primer mensaje.</string>
    <string name="ai_feature_settings_reasoning_expand_toggle_title">Expandir razonamiento por defecto</string>
    <string name="ai_feature_settings_reasoning_expand_toggle_desc">Si el contenido de razonamiento dentro de las respuestas de IA se expande por defecto.</string>
    <string name="ai_feature_settings_prompt_expand_toggle_title">Expandir indicaciones por defecto</string>
    <string name="ai_feature_settings_prompt_expand_toggle_desc">Si el contenido de las indicaciones dentro del chat se expande por defecto.</string>
    <string name="ai_feature_settings_tool_call_expand_toggle_title">Expandir tarjetas de herramientas por defecto</string>
    <string name="ai_feature_settings_tool_call_expand_toggle_desc">Si las tarjetas de resultados de llamadas a herramientas dentro de las respuestas de IA se expanden por defecto.</string>
    <string name="ai_feature_settings_agent_section_title">Ejecución del agente</string>
    <string name="ai_feature_settings_agent_section_desc">Controla el número máximo de iteraciones consecutivas en una sola ejecución automática del agente. Después de alcanzar el límite, aún puede continuar manualmente desde la página de chat.</string>
    <string name="ai_feature_settings_max_iterations_title">Máximo de iteraciones consecutivas</string>
    <string name="ai_feature_settings_max_iterations_desc">Número máximo de iteraciones en una sola ejecución automática del agente. El rango configurable es de %1$d a %2$d iteraciones.</string>
