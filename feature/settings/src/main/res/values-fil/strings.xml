    <string name="ai_feature_settings_agent_section_title">Pagpapatupad ng Agent</string>
    <string name="ai_feature_settings_agent_section_desc">Kinokontrol ang maximum na bilang ng magkakasunod na iterations sa isang solong Agent auto-run. Pagkatapos maabot ang limitasyon, maaari ka pa ring magpatuloy nang manu-mano mula sa chat page.</string>
