    <string name="demo_glass_showcase_selection_title" translatable="false">选择类组件</string>
    <string name="demo_glass_showcase_selection_desc" translatable="false">Switch、FilterChip 与 SegmentedButton 使用相同的玻璃基底，但保留各自系统组件的交互模型。</string>
