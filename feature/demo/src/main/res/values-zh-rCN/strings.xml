<resources>
    <string name="demo_glass_showcase_title" translatable="false">Glass 组件展示</string>
    <string name="demo_glass_showcase_button_title" translatable="false">Glass Showcase</string>
    <string name="demo_glass_showcase_sheet_subtitle" translatable="false">展示当前主题下的扁平玻璃卡片、按钮、容器、选择器与输入容器效果；所有示例颜色均跟随主题变化。</string>

    <string name="demo_glass_showcase_mode_title" translatable="false">风格档位</string>
    <string name="demo_glass_showcase_mode_desc" translatable="false">通过分段按钮切换同一套组件的玻璃强度，观察浅色 / 深色主题下的层次变化。</string>
    <string name="demo_glass_showcase_mode_quiet" translatable="false">轻薄</string>
    <string name="demo_glass_showcase_mode_balanced" translatable="false">标准</string>
    <string name="demo_glass_showcase_mode_expressive" translatable="false">强调</string>

    <string name="demo_glass_showcase_tint_title" translatable="false">色调保留验证</string>
    <string name="demo_glass_showcase_tint_desc" translatable="false">有色玻璃不应该只剩一层发白蒙版；传入主题色后，容器需要仍能读出明显的色相差异与边界。</string>
    <string name="demo_glass_showcase_tint_primary" translatable="false">主色玻璃</string>
    <string name="demo_glass_showcase_tint_secondary" translatable="false">辅助色玻璃</string>
    <string name="demo_glass_showcase_tint_error" translatable="false">警示色玻璃</string>

    <string name="demo_glass_showcase_colored_material_title" translatable="false">彩色玻璃材质</string>
    <string name="demo_glass_showcase_colored_material_desc" translatable="false">对比普通透明彩色玻璃与液态彩色玻璃：前者更克制，后者强调边缘折射、焦散和镜片高光。</string>
    <string name="demo_glass_showcase_colored_plain_title" translatable="false">普通透明</string>
    <string name="demo_glass_showcase_colored_plain_body" translatable="false">适合列表卡片、工具条和信息分组。</string>
    <string name="demo_glass_showcase_colored_liquid_title" translatable="false">液态玻璃</string>
    <string name="demo_glass_showcase_colored_liquid_body" translatable="false">适合浮层、选中态和强调内容。</string>

    <string name="demo_glass_showcase_cards_title" translatable="false">Card</string>
    <string name="demo_glass_showcase_cards_desc" translatable="false">`GlassCard` 现在分为点击版和非点击版重载，参数顺序尽量贴近系统 Card。</string>
    <string name="demo_glass_showcase_primary_card_title" translatable="false">主题联动的内容卡片</string>
    <string name="demo_glass_showcase_primary_card_body" translatable="false">容器色与内容色来自当前主题，不写死颜色；玻璃关闭时会自动回退为普通 Material Card。</string>
    <string name="demo_glass_showcase_clickable_card_title" translatable="false">可点击卡片</string>
    <string name="demo_glass_showcase_clickable_card_body" translatable="false">已点击 %1$d 次，当前会保留 Card 的点击语义与交互方式。</string>

    <string name="demo_glass_showcase_actions_title" translatable="false">Button 与 Surface</string>
    <string name="demo_glass_showcase_actions_desc" translatable="false">按钮和可点击 Surface 共享同一套 ultra-flat glass 基座，按压反馈仍保持轻量。</string>
    <string name="demo_glass_showcase_primary_button" translatable="false">主按钮</string>
    <string name="demo_glass_showcase_secondary_button" translatable="false">色调按钮</string>
