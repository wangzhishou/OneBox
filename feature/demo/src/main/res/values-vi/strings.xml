<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="demo_glass_showcase_title">Hiển thị thành phần Glass</string>
    <string name="demo_glass_showcase_button_title">Glass Showcase</string>
    <string name="demo_glass_showcase_sheet_subtitle">Hiển thị hiệu ứng thẻ kính phẳng, nút, vùng chứa, bộ chọn và vùng nhập liệu theo chủ đề hiện tại; tất cả màu ví dụ đều thay đổi theo chủ đề.</string>
    <string name="demo_glass_showcase_mode_title">Mức phong cách</string>
    <string name="demo_glass_showcase_mode_desc">Chuyển đổi cường độ kính của cùng bộ thành phần bằng nút phân đoạn, quan sát sự thay đổi lớp trong chủ đề sáng / tối.</string>
    <string name="demo_glass_showcase_mode_quiet">Mỏng nhẹ</string>
    <string name="demo_glass_showcase_mode_balanced">Tiêu chuẩn</string>
    <string name="demo_glass_showcase_mode_expressive">Nhấn mạnh</string>
    <string name="demo_glass_showcase_tint_title">Xác minh giữ tông màu</string>
    <string name="demo_glass_showcase_tint_desc">Kính có màu không nên chỉ còn một lớp phủ trắng mờ; sau khi truyền màu chủ đề, vùng chứa vẫn cần đọc được sự khác biệt rõ rệt về sắc thái và đường viền.</string>
    <string name="demo_glass_showcase_tint_primary">Kính màu chính</string>
    <string name="demo_glass_showcase_tint_secondary">Kính màu phụ</string>
    <string name="demo_glass_showcase_tint_error">Kính màu cảnh báo</string>
    <string name="demo_glass_showcase_colored_material_title">Chất liệu kính màu</string>
    <string name="demo_glass_showcase_colored_material_desc">So sánh kính màu trong suốt thông thường với kính màu lỏng: loại trước tiết chế hơn, loại sau nhấn mạnh khúc xạ viền, tán xạ và điểm sáng thấu kính.</string>
    <string name="demo_glass_showcase_colored_plain_title">Trong suốt thông thường</string>
    <string name="demo_glass_showcase_colored_plain_body">Phù hợp cho thẻ danh sách, thanh công cụ và nhóm thông tin.</string>
    <string name="demo_glass_showcase_colored_liquid_title">Kính lỏng</string>
    <string name="demo_glass_showcase_colored_liquid_body">Phù hợp cho lớp nổi, trạng thái chọn và nội dung nhấn mạnh.</string>
    <string name="demo_glass_showcase_consistency_title">Đối chiếu tính nhất quán đường ống</string>
    <string name="demo_glass_showcase_consistency_desc">Cùng tông màu, cùng mức lần lượt được kết xuất qua GlassCard, GlassSurface, coloredGlass, cảm nhận khi bật/tắt kính đều phải nhất quán.</string>
    <string name="demo_glass_showcase_cards_title">Card</string>
    <string name="demo_glass_showcase_cards_desc">`GlassCard` hiện được chia thành phiên bản có thể nhấp và không thể nhấp, thứ tự tham số cố gắng gần với Card hệ thống.</string>
    <string name="demo_glass_showcase_primary_card_title">Thẻ nội dung liên kết chủ đề</string>
    <string name="demo_glass_showcase_primary_card_body">Màu vùng chứa và màu nội dung đến từ chủ đề hiện tại, không cố định màu; khi tắt kính sẽ tự động chuyển về Material Card thông thường.</string>
    <string name="demo_glass_showcase_clickable_card_title">Thẻ có thể nhấp</string>
    <string name="demo_glass_showcase_clickable_card_body">Đã nhấp %1$d lần, hiện vẫn giữ ngữ nghĩa và cách tương tác nhấp của Card.</string>
    <string name="demo_glass_showcase_actions_title">Button và Surface</string>
    <string name="demo_glass_showcase_actions_desc">Nút và Surface có thể nhấp dùng chung một nền ultra-flat glass, phản hồi nhấn vẫn giữ nhẹ nhàng.</string>
    <string name="demo_glass_showcase_primary_button">Nút chính</string>
    <string name="demo_glass_showcase_secondary_button">Nút tông màu</string>
    <string name="demo_glass_showcase_surface_title">Surface có thể nhấn</string>
    <string name="demo_glass_showcase_surface_body">Tổng số tương tác %1$d lần, màu sắc và lớp đến từ chủ đề hiện tại.</string>
    <string name="demo_glass_showcase_selection_title">Thành phần chọn</string>
    <string name="demo_glass_showcase_selection_desc">Switch, FilterChip và SegmentedButton dùng cùng nền kính, nhưng giữ nguyên mô hình tương tác của từng thành phần hệ thống.</string>
    <string name="demo_glass_showcase_switch_title">Công tắc thông báo</string>
