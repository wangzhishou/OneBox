    <string name="demo_glass_showcase_input_title">Vùng chứa nhập liệu</string>
    <string name="demo_glass_showcase_input_desc">Ở đây chỉ hiển thị `GlassTextFieldContainer`, không lặp lại `GlassOutlinedTextField` đã được trình bày riêng.</string>
    <string name="demo_glass_showcase_input_placeholder">Tìm kiếm thành phần, chuyển chủ đề để quan sát chi tiết</string>
    <string name="demo_schedule_database_title">Xem trước cơ sở dữ liệu lịch</string>
    <string name="demo_schedule_database_description">Đọc trực tiếp bảng schedule_event, thuận tiện xác nhận dữ liệu lịch đã ghi vào cơ sở dữ liệu hiện tại.</string>
