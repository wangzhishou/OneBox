<resources>
    <string name="dead_pixel_test">Тест битых пикселей</string>
    <string name="dead_pixel_test_description">Полноэкранная смена цветов для обнаружения битых или застрявших пикселей.</string>
    <string name="dead_pixel_color_white">Белый</string>
    <string name="dead_pixel_color_black">Черный</string>
    <string name="dead_pixel_color_red">Красный</string>
    <string name="dead_pixel_color_green">Зеленый</string>
    <string name="dead_pixel_color_blue">Синий</string>
    <string name="dead_pixel_hint">Нажмите, чтобы изменить цвет... Свайпы вправо и влево позволяют переключаться туда и обратно.</string>
    <string name="dead_pixel_progress">%1$d / %2$d</string>
    <string name="dead_pixel_grid_on">Показать сетку</string>
    <string name="dead_pixel_grid_off">Скрыть сетку</string>
    <string name="dead_pixel_auto_play">Автопрокрутка</string>
    <string name="dead_pixel_auto_stop">Остановить!</string>
