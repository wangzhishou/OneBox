    <string name="agent_tool_query_schedule_events_title">Query Schedule Events</string>
    <string name="agent_tool_query_schedule_events_summary">Query local schedule events within a date range.</string>
    <string name="agent_tool_query_schedule_events_description">Query local schedule events overlapping a date range. `start_date` defaults to today and `end_date` defaults to 6 days after it (a 7-day window). Returns up to 50 events ordered by start time, each with its id, title, time, location and note; the id can be passed to delete_schedule_event.</string>
    <string name="agent_tool_query_schedule_events_param_start_date">Range start date, yyyy-MM-dd; defaults to today.</string>
    <string name="agent_tool_query_schedule_events_param_end_date">Range end date (inclusive), yyyy-MM-dd; defaults to 6 days after start_date.</string>
    <string name="agent_tool_query_schedule_events_end_before_start">end_date cannot be earlier than start_date.</string>
    <string name="agent_tool_query_schedule_events_empty">No events in this range</string>
    <string name="agent_tool_query_schedule_events_failed">Failed to query schedule events: %1$s</string>
