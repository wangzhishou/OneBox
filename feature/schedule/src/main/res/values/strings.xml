    <string name="agent_tool_add_schedule_event_title">Add Schedule Event</string>
    <string name="agent_tool_add_schedule_event_summary">Create a local schedule event with title, time, note and location.</string>
    <string name="agent_tool_add_schedule_event_description">Create a local schedule event. `title` and `start` are required; `end` defaults to one hour after start (or the next day for all-day events). Times accept ISO strings: 2026-09-10T14:00, 2026-09-10T14:00:00+08:00, or a plain date 2026-09-10.</string>
    <string name="agent_tool_add_schedule_event_param_title">Event title, required.</string>
    <string name="agent_tool_add_schedule_event_param_start">Start time, ISO format, e.g. 2026-09-10T14:00; a plain date means 00:00 that day.</string>
    <string name="agent_tool_add_schedule_event_param_end">End time, ISO format. Optional; defaults to one hour after start, or the next day for all-day events.</string>
    <string name="agent_tool_add_schedule_event_param_all_day">Whether this is an all-day event, default false.</string>
    <string name="agent_tool_add_schedule_event_param_description">Optional note for the event.</string>
    <string name="agent_tool_add_schedule_event_param_location">Optional location of the event.</string>
    <string name="agent_tool_add_schedule_event_title_required">The title parameter is required and cannot be blank.</string>
    <string name="agent_tool_add_schedule_event_failed">Failed to add schedule event: %1$s</string>
