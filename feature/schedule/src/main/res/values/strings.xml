    </string-array>

    <string name="agent_tool_delete_schedule_event_title">Delete Schedule Event</string>
    <string name="agent_tool_delete_schedule_event_summary">Delete a local schedule event by its id.</string>
    <string name="agent_tool_delete_schedule_event_description">Delete a local schedule event by event_id (usually from the result of query_schedule_events). Deletion also removes its system-calendar bindings and cannot be undone, so user confirmation is required before execution.</string>
