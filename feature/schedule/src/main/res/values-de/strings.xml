    <string name="agent_tool_query_schedule_events_title">Zeitplaneinträge abfragen</string>
    <string name="agent_tool_query_schedule_events_summary">Lokale Zeitplaneinträge innerhalb eines Datumsbereichs abfragen.</string>
    <string name="agent_tool_query_schedule_events_description">Lokale Zeitplaneinträge abfragen, die einen Datumsbereich überschneiden. `start_date` ist standardmäßig heute und `end_date` standardmäßig 6 Tage danach (ein 7-Tage-Fenster). Gibt bis zu 50 Einträge sortiert nach Startzeit zurück, jeweils mit ID, Titel, Zeit, Ort und Notiz; die ID kann an delete_schedule_event übergeben werden.</string>
    <string name="agent_tool_query_schedule_events_param_start_date">Startdatum des Bereichs, JJJJ-MM-TT; Standard ist heute.</string>
    <string name="agent_tool_query_schedule_events_param_end_date">Enddatum des Bereichs (einschließlich), JJJJ-MM-TT; Standard ist 6 Tage nach start_date.</string>
    <string name="agent_tool_query_schedule_events_end_before_start">end_date darf nicht vor start_date liegen.</string>
