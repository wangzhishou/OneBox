    <string name="agent_tool_add_schedule_event_title">Zeitplanereignis hinzufügen</string>
    <string name="agent_tool_add_schedule_event_summary">Erstellen Sie ein lokales Zeitplanereignis mit Titel, Zeit, Notiz und Ort.</string>
    <string name="agent_tool_add_schedule_event_description">Erstellen Sie ein lokales Zeitplanereignis. `title` und `start` sind erforderlich; `end` standardmäßig eine Stunde nach Start (oder am nächsten Tag für ganztägige Ereignisse). Zeiten akzeptieren ISO-Strings: 2026-09-10T14:00, 2026-09-10T14:00:00+08:00 oder ein einfaches Datum 2026-09-10.</string>
    <string name="agent_tool_add_schedule_event_param_title">Ereignistitel, erforderlich.</string>
