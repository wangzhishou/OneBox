    <string name="agent_tool_query_schedule_events_title">Запрос событий расписания</string>
    <string name="agent_tool_query_schedule_events_summary">Запрос локальных событий расписания в пределах диапазона дат.</string>
    <string name="agent_tool_query_schedule_events_description">Запрос локальных событий расписания, пересекающихся с диапазоном дат. `start_date` по умолчанию — сегодня, а `end_date` по умолчанию — через 6 дней (окно в 7 дней). Возвращает до 50 событий, упорядоченных по времени начала, каждое с его id, названием, временем, местом и заметкой; id можно передать в delete_schedule_event.</string>
    <string name="agent_tool_query_schedule_events_param_start_date">Дата начала диапазона, гггг-ММ-дд; по умолчанию — сегодня.</string>
    <string name="agent_tool_query_schedule_events_param_end_date">Дата окончания диапазона (включительно), гггг-ММ-дд; по умолчанию — через 6 дней после start_date.</string>
    <string name="agent_tool_query_schedule_events_end_before_start">end_date не может быть раньше start_date.</string>
