    <string name="agent_tool_add_schedule_event_param_all_day">是否全天事件，默认 false。</string>
    <string name="agent_tool_add_schedule_event_param_description">事件备注，可选。</string>
    <string name="agent_tool_add_schedule_event_param_location">事件地点，可选。</string>
