    <string name="agent_tool_add_schedule_event_title">新建日程</string>
    <string name="agent_tool_add_schedule_event_summary">创建一条本地日程，支持标题、时间、备注与地点。</string>
    <string name="agent_tool_add_schedule_event_description">创建一条本地日程事件。title 与 start 必填；end 缺省时默认为开始时间后 1 小时（全天事件则为次日）。时间使用 ISO 格式字符串：2026-09-10T14:00、2026-09-10T14:00:00+08:00，或纯日期 2026-09-10。</string>
