    <string name="agent_tool_query_schedule_events_title">查询日程</string>
    <string name="agent_tool_query_schedule_events_summary">按日期范围查询本地日程事件。</string>
    <string name="agent_tool_query_schedule_events_description">查询与指定日期范围有交集的本地日程事件。start_date 缺省为今天，end_date 缺省为其后 6 天（即默认 7 天窗口）。最多返回 50 条，按开始时间升序，每条包含 id、标题、时间、地点与备注；id 可传给 delete_schedule_event 删除。</string>
    <string name="agent_tool_query_schedule_events_param_start_date">范围开始日期，yyyy-MM-dd；缺省为今天。</string>
    <string name="agent_tool_query_schedule_events_param_end_date">范围结束日期（含当天），yyyy-MM-dd；缺省为 start_date 后 6 天。</string>
    <string name="agent_tool_query_schedule_events_end_before_start">end_date 不能早于 start_date。</string>
