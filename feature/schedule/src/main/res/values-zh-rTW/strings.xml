    <string name="agent_tool_query_schedule_events_title">查詢日程</string>
    <string name="agent_tool_query_schedule_events_summary">按日期範圍查詢本地日程事件。</string>
    <string name="agent_tool_query_schedule_events_description">查詢與指定日期範圍有交集的本地日程事件。start_date 預設為今天，end_date 預設為其後 6 天（即預設 7 天視窗）。最多回傳 50 筆，按開始時間升序，每筆包含 id、標題、時間、地點與備註；id 可傳給 delete_schedule_event 刪除。</string>
    <string name="agent_tool_query_schedule_events_param_start_date">範圍開始日期，yyyy-MM-dd；預設為今天。</string>
    <string name="agent_tool_query_schedule_events_param_end_date">範圍結束日期（含當天），yyyy-MM-dd；預設為 start_date 後 6 天。</string>
