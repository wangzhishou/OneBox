    <string name="agent_tool_query_schedule_events_title">I-query ang mga Schedule Event</string>
    <string name="agent_tool_query_schedule_events_summary">I-query ang mga lokal na schedule event sa loob ng isang saklaw ng petsa.</string>
    <string name="agent_tool_query_schedule_events_description">I-query ang mga lokal na schedule event na nagsasapawan sa isang saklaw ng petsa. Ang `start_date` ay default sa ngayon at ang `end_date` ay default sa 6 na araw pagkatapos nito (isang 7-araw na window). Nagbabalik ng hanggang 50 event na nakaayos ayon sa oras ng pagsisimula, bawat isa ay may id, pamagat, oras, lokasyon at tala; ang id ay maaaring ipasa sa delete_schedule_event.</string>
    <string name="agent_tool_query_schedule_events_param_start_date">Saklaw na petsa ng pagsisimula, yyyy-MM-dd; default sa ngayon.</string>
    <string name="agent_tool_query_schedule_events_param_end_date">Saklaw na petsa ng pagtatapos (kasama), yyyy-MM-dd; default sa 6 na araw pagkatapos ng start_date.</string>
    <string name="agent_tool_query_schedule_events_end_before_start">Ang end_date ay hindi maaaring mas maaga kaysa sa start_date.</string>
