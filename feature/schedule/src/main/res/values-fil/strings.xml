    <string name="agent_tool_add_schedule_event_title">Magdagdag ng Schedule Event</string>
    <string name="agent_tool_add_schedule_event_summary">Gumawa ng lokal na schedule event na may pamagat, oras, tala, at lokasyon.</string>
    <string name="agent_tool_add_schedule_event_description">Gumawa ng lokal na schedule event. Kinakailangan ang `title` at `start`; ang `end` ay default na isang oras pagkatapos ng simula (o sa susunod na araw para sa all-day events). Tinatanggap ng mga oras ang ISO strings: 2026-09-10T14:00, 2026-09-10T14:00:00+08:00, o isang simpleng petsa 2026-09-10.</string>
    <string name="agent_tool_add_schedule_event_param_title">Pamagat ng event, kinakailangan.</string>
    <string name="agent_tool_add_schedule_event_param_start">Oras ng simula, ISO format, hal. 2026-09-10T14:00; ang simpleng petsa ay nangangahulugang 00:00 sa araw na iyon.</string>
    <string name="agent_tool_add_schedule_event_param_end">Oras ng pagtatapos, ISO format. Opsyonal; default ay isang oras pagkatapos ng simula, o sa susunod na araw para sa all-day events.</string>
