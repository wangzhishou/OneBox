    <string name="agent_tool_query_schedule_events_title">शेड्यूल इवेंट क्वेरी करें</string>
    <string name="agent_tool_query_schedule_events_summary">तारीख सीमा के भीतर स्थानीय शेड्यूल इवेंट क्वेरी करें।</string>
    <string name="agent_tool_query_schedule_events_description">तारीख सीमा को ओवरलैप करने वाले स्थानीय शेड्यूल इवेंट क्वेरी करें। `start_date` डिफ़ॉल्ट रूप से आज और `end_date` इसके 6 दिन बाद (7-दिन की विंडो) होता है। प्रारंभ समय के अनुसार क्रमबद्ध 50 तक इवेंट लौटाता है, प्रत्येक में उसका id, शीर्षक, समय, स्थान और नोट होता है; id को delete_schedule_event में पास किया जा सकता है।</string>
    <string name="agent_tool_query_schedule_events_param_start_date">सीमा प्रारंभ तिथि, yyyy-MM-dd; डिफ़ॉल्ट आज।</string>
    <string name="agent_tool_query_schedule_events_param_end_date">सीमा समाप्ति तिथि (सम्मिलित), yyyy-MM-dd; डिफ़ॉल्ट start_date के 6 दिन बाद।</string>
