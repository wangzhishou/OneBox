    <string name="agent_tool_query_schedule_events_title">Takvim Etkinliklerini Sorgula</string>
    <string name="agent_tool_query_schedule_events_summary">Bir tarih aralığındaki yerel takvim etkinliklerini sorgular.</string>
    <string name="agent_tool_query_schedule_events_description">Bir tarih aralığıyla çakışan yerel takvim etkinliklerini sorgular. `start_date` varsayılan olarak bugünü, `end_date` ise ondan 6 gün sonrasını (7 günlük bir pencere) varsayar. Başlangıç saatine göre sıralanmış en fazla 50 etkinlik döndürür; her biri kimliği, başlığı, zamanı, konumu ve notuyla birlikte gelir; kimlik, delete_schedule_event\'e aktarılabilir.</string>
    <string name="agent_tool_query_schedule_events_param_start_date">Aralık başlangıç tarihi, yyyy-MM-dd; varsayılan olarak bugün.</string>
    <string name="agent_tool_query_schedule_events_param_end_date">Aralık bitiş tarihi (dahil), yyyy-MM-dd; varsayılan olarak start_date\'den 6 gün sonrası.</string>
