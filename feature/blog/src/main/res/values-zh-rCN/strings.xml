<resources>
    <!-- AI Agent 工具: submit_feedback -->
    <string name="agent_tool_submit_feedback_title">提交反馈</string>
    <string name="agent_tool_submit_feedback_summary">向开发团队提交建议、问题反馈或功能请求</string>
    <string name="agent_tool_submit_feedback_description">将用户的建议、问题反馈或功能请求提交给开发团队。无需登录。content 为必填的反馈内容;可选的联系方式会附在反馈内容末尾,便于开发者回访。</string>
    <string name="agent_tool_submit_feedback_param_content">反馈内容,必填,最长 2000 字。请详细描述遇到的问题、建议或想要的功能。</string>
    <string name="agent_tool_submit_feedback_param_contact">可选联系方式(邮箱、QQ、微信等),便于开发者就反馈内容回访。</string>
    <string name="agent_tool_submit_feedback_success">反馈已提交成功,感谢你的反馈!开发团队会尽快查看处理,你可以在反馈页面查看回复。</string>
    <string name="agent_tool_submit_feedback_failed">反馈提交失败:%1$s</string>
    <string name="agent_tool_submit_feedback_error_empty_content">反馈内容不能为空</string>
    <string name="agent_tool_submit_feedback_error_too_long">反馈内容超出长度限制(最长 %1$d 字)</string>
    <string name="agent_tool_submit_feedback_contact_label">联系方式</string>
    <string name="agent_tool_submit_feedback_unknown_error">未知错误</string>
    <string name="agent_tool_submit_feedback_open_link">查看我的反馈</string>

    <string-array name="agent_tool_submit_feedback_keywords">
        <item>反馈</item>
        <item>建议</item>
        <item>意见</item>
        <item>问题</item>
        <item>功能请求</item>
    </string-array>

    <string-array name="agent_tool_submit_feedback_examples">
        <item>帮我提交一个反馈:希望能支持夜间模式自动切换</item>
        <item>我要反馈一个问题,扫码功能偶尔闪退</item>
        <item>提交反馈:建议增加批量重命名功能,我的邮箱是 test@example.com</item>
    </string-array>
</resources>
