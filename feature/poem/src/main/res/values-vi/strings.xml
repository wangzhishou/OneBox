    <string name="agent_tool_get_poem_detail_title">Chi tiết bài thơ</string>
    <string name="agent_tool_get_poem_detail_summary">Lấy toàn văn bài thơ, bao gồm bản dịch và diễn giải đã tạo</string>
    <string name="agent_tool_get_poem_detail_description">Lấy toàn văn một bài thơ cổ Trung Quốc; nếu trước đó đã tạo bản dịch hiện đại bằng AI và diễn giải thi ý, trả về kèm theo. Có thể truyền poem_id (id trong kết quả search_poem) hoặc tiêu đề bài thơ, tiêu đề có thể kết hợp author để phân biệt. Bài thơ lấy từ mạng sẽ được ghi vào thư viện cục bộ, nhờ đó liên kết trang chi tiết mới dùng được.</string>
    <string name="agent_tool_get_poem_detail_param_poem_id">id bài thơ, tức id trong kết quả search_poem</string>
