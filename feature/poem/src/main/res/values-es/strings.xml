    <string name="agent_tool_search_poem_title">Buscar poemas</string>
    <string name="agent_tool_search_poem_summary">Buscar poemas clásicos chinos por palabra clave</string>
    <string name="agent_tool_search_poem_description">Busca poemas clásicos chinos por palabra clave, coincidiendo con títulos, poetas y texto de versos. Las palabras clave de 3 o más caracteres usan búsqueda de texto completo; las más cortas (como un nombre de poeta de dos caracteres) usan muestreo filtrado. Devuelve id del poema, título, poeta, dinastía y un extracto. Llama a get_poem_detail con el id o el título para obtener el texto completo.</string>
    <string name="agent_tool_search_poem_param_query">Palabra clave de búsqueda: un fragmento de verso, título de poema o nombre de poeta</string>
    <string name="agent_tool_search_poem_param_max_results">Número máximo de resultados, 1-20, predeterminado 10</string>
    <string name="agent_tool_search_poem_query_required">la consulta no debe estar en blanco</string>
    <string name="agent_tool_search_poem_empty">No se encontraron poemas que coincidan con \"%1$s\"</string>
    <string name="agent_tool_search_poem_failed">Error al buscar poemas: %1$s</string>
