    <string name="agent_tool_get_poem_detail_title">Detalle del poema</string>
    <string name="agent_tool_get_poem_detail_summary">Texto completo de un poema, con traducción e interpretación cuando esté disponible</string>
    <string name="agent_tool_get_poem_detail_description">Obtén el texto completo de un poema clásico chino, además de su traducción moderna generada por IA y su interpretación si se generaron previamente. Proporciona poem_id (de los resultados de search_poem) o el título del poema, opcionalmente con el autor para desambiguar. Los poemas resueltos en línea se guardan en la biblioteca local para que el enlace de la página de detalle funcione.</string>
    <string name="agent_tool_get_poem_detail_param_poem_id">Id del poema, tal como lo devuelve search_poem</string>
    <string name="agent_tool_get_poem_detail_param_title">Título del poema, utilizado cuando se desconoce el poem_id</string>
    <string name="agent_tool_get_poem_detail_param_author">Nombre del poeta, opcional, se usa junto con el título para desambiguar</string>
