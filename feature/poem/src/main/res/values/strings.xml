        <item>full text</item>
        <item>translation</item>
        <item>insight</item>
        <item>诗词详情</item>
        <item>全文</item>
    </string-array>
    <string-array name="agent_tool_get_poem_detail_examples">
        <item>Show the full text of 静夜思</item>
        <item>Get the poem with id 123</item>
        <item>把《静夜思》的全文和译文给我</item>
    </string-array>

