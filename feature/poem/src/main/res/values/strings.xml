    <string name="agent_tool_search_poem_title">Search Poems</string>
    <string name="agent_tool_search_poem_summary">Search Chinese classical poems by keyword</string>
    <string name="agent_tool_search_poem_description">Search Chinese classical poems by keyword, matching titles, poets and verse text. Keywords with 3 or more characters use full-text search; shorter keywords (such as a two-character poet name) use filtered sampling. Returns poem id, title, poet, dynasty and an excerpt. Call get_poem_detail with the id or title to get the full text.</string>
    <string name="agent_tool_search_poem_param_query">Search keyword: a verse fragment, poem title or poet name</string>
    <string name="agent_tool_search_poem_param_max_results">Max number of results, 1-20, default 10</string>
    <string name="agent_tool_search_poem_query_required">query must not be blank</string>
    <string name="agent_tool_search_poem_empty">No poems matched \"%1$s\"</string>
    <string name="agent_tool_search_poem_failed">Failed to search poems: %1$s</string>
    <string-array name="agent_tool_search_poem_keywords">
        <item>poem</item>
        <item>poetry</item>
        <item>verse</item>
        <item>poet</item>
        <item>古诗</item>
        <item>诗词</item>
    </string-array>
    <string-array name="agent_tool_search_poem_examples">
        <item>Search poems about the moon</item>
        <item>Find poems by Li Bai</item>
        <item>有哪些写月亮的古诗</item>
    </string-array>

    <string name="agent_tool_get_poem_detail_title">Poem Detail</string>
    <string name="agent_tool_get_poem_detail_summary">Full text of a poem, with translation and insight when available</string>
    <string name="agent_tool_get_poem_detail_description">Get the full text of a Chinese classical poem, plus its AI-generated modern translation and insight if they were previously generated. Provide poem_id (from search_poem results) or the poem title, optionally with author to disambiguate. Poems resolved online are saved to the local library so the detail page link works.</string>
    <string name="agent_tool_get_poem_detail_param_poem_id">Poem id, as returned by search_poem</string>
    <string name="agent_tool_get_poem_detail_param_title">Poem title, used when poem_id is unknown</string>
    <string name="agent_tool_get_poem_detail_param_author">Poet name, optional, used together with title to disambiguate</string>
    <string name="agent_tool_get_poem_detail_id_or_title_required">Provide poem_id or title</string>
    <string name="agent_tool_get_poem_detail_not_found">Poem not found: %1$s</string>
    <string name="agent_tool_get_poem_detail_failed">Failed to get poem detail: %1$s</string>
    <string-array name="agent_tool_get_poem_detail_keywords">
