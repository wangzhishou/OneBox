    <string name="agent_tool_search_poem_summary">Pesquisar poemas clássicos chineses por palavra-chave</string>
    <string name="agent_tool_search_poem_description">Pesquise poemas clássicos chineses por palavra-chave, correspondendo a títulos, poetas e texto dos versos. Palavras-chave com 3 ou mais caracteres usam pesquisa de texto completo; palavras-chave mais curtas (como um nome de poeta com dois caracteres) usam amostragem filtrada. Retorna id do poema, título, poeta, dinastia e um trecho. Chame get_poem_detail com o id ou título para obter o texto completo.</string>
    <string name="agent_tool_search_poem_param_query">Palavra-chave de pesquisa: um fragmento de verso, título do poema ou nome do poeta</string>
    <string name="agent_tool_search_poem_param_max_results">Número máximo de resultados, 1-20, padrão 10</string>
    <string name="agent_tool_search_poem_query_required">a consulta não pode estar em branco</string>
