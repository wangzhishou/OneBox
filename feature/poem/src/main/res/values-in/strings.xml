    <string name="agent_tool_search_poem_title">Cari Puisi</string>
    <string name="agent_tool_search_poem_summary">Cari puisi klasik Tiongkok berdasarkan kata kunci</string>
    <string name="agent_tool_search_poem_description">Cari puisi klasik Tiongkok berdasarkan kata kunci, mencocokkan judul, penyair, dan teks ayat. Kata kunci dengan 3 karakter atau lebih menggunakan pencarian teks lengkap; kata kunci yang lebih pendek (seperti nama penyair dua karakter) menggunakan sampel yang difilter. Mengembalikan id puisi, judul, penyair, dinasti, dan kutipan. Panggil get_poem_detail dengan id atau judul untuk mendapatkan teks lengkap.</string>
    <string name="agent_tool_search_poem_param_query">Kata kunci pencarian: fragmen ayat, judul puisi, atau nama penyair</string>
    <string name="agent_tool_search_poem_param_max_results">Jumlah maksimum hasil, 1-20, default 10</string>
    <string name="agent_tool_search_poem_query_required">kueri tidak boleh kosong</string>
    <string name="agent_tool_search_poem_empty">Tidak ada puisi yang cocok dengan \"%1$s\"</string>
