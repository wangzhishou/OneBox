    <string name="agent_tool_add_habit_description">Tạo thói quen mới trong mô-đun điểm danh thói quen. Hỗ trợ tên tùy chỉnh, biểu tượng, tần suất lặp lại (hàng ngày / N lần mỗi tuần / N lần mỗi tháng / tùy chỉnh thứ trong tuần), thời gian nhắc nhở hàng ngày tùy chọn và ghi chú.</string>
    <string name="agent_tool_add_habit_param_name">Tên thói quen, ví dụ \"uống tám cốc nước mỗi ngày\"</string>
    <string name="agent_tool_add_habit_param_icon">Khóa biểu tượng, tùy chọn: waterdrop (uống nước), sunrise (dậy sớm), running (thể thao), book (đọc sách), meditation (thiền), moon (ngủ sớm), toothbrush (đánh răng), pill (uống thuốc), fruit (trái cây), writing (viết lách), piggybank (tiết kiệm), dumbbell (tập gym)</string>
    <string name="agent_tool_add_habit_param_repeat_type">Loại lặp lại: daily (hàng ngày)/ weekly_times (N lần mỗi tuần)/ monthly_times (N lần mỗi tháng)/ custom_weekdays (tùy chỉnh thứ trong tuần)</string>
    <string name="agent_tool_add_habit_param_repeat_target">Số lần mỗi tuần hoặc mỗi tháng, 1-30, chỉ có hiệu lực với weekly_times / monthly_times</string>
    <string name="agent_tool_add_habit_param_weekdays">Tùy chỉnh thứ trong tuần, mảng 1-7 (1=Thứ Hai, 7=Chủ Nhật), chỉ có hiệu lực với custom_weekdays</string>
    <string name="agent_tool_add_habit_param_remind_time">Thời gian nhắc nhở hàng ngày, HH:mm (định dạng 24 giờ), tùy chọn</string>
