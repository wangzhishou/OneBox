    <string name="agent_tool_check_in_habit_title">Check-in d\'habitudes</string>
    <string name="agent_tool_check_in_habit_summary">Effectuer le check-in d\'un jour pour une habitude donnée</string>
    <string name="agent_tool_check_in_habit_description">Marquer une habitude comme check-in à une date donnée (aujourd\'hui par défaut). Utilisez habit_id pour un ciblage précis, ou habit_name pour une correspondance approximative. Un check-in répété le même jour ne crée pas d\'enregistrement en double.</string>
    <string name="agent_tool_check_in_habit_param_habit_id">ID de l\'habitude. À utiliser en priorité si connu ; sinon, correspondance avec habit_name</string>
    <string name="agent_tool_check_in_habit_param_habit_name">Nom de l\'habitude, correspondance approximative si habit_id n\'est pas fourni</string>
    <string name="agent_tool_check_in_habit_param_date">Date de check-in, yyyy-MM-dd, aujourd\'hui par défaut, ne peut pas être une date future</string>
