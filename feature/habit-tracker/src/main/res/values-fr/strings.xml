    <string name="agent_tool_add_habit_title">Ajouter une habitude</string>
    <string name="agent_tool_add_habit_summary">Créer une nouvelle habitude dans le check-in d\'habitudes</string>
    <string name="agent_tool_add_habit_description">Créer une nouvelle habitude dans le module de check-in d\'habitudes. Prend en charge un nom personnalisé, une icône, une fréquence de répétition (chaque jour / N fois par semaine / N fois par mois / jours de la semaine personnalisés), une heure de rappel quotidienne facultative et une note.</string>
    <string name="agent_tool_add_habit_param_name">Nom de l\'habitude, ex. « boire huit verres d\'eau par jour »</string>
    <string name="agent_tool_add_habit_param_icon">Clé d\'icône, en option : waterdrop (boire de l\'eau), sunrise (se lever tôt), running (sport), book (lecture), meditation (méditation), moon (se coucher tôt), toothbrush (se brosser les dents), pill (prendre un médicament), fruit (fruits), writing (écriture), piggybank (économiser), dumbbell (fitness)</string>
    <string name="agent_tool_add_habit_param_repeat_type">Type de répétition : daily (chaque jour) / weekly_times (N fois par semaine) / monthly_times (N fois par mois) / custom_weekdays (jours de la semaine personnalisés)</string>
    <string name="agent_tool_add_habit_param_repeat_target">Nombre de fois par semaine ou par mois, 1-30, valide uniquement pour weekly_times / monthly_times</string>
    <string name="agent_tool_add_habit_param_weekdays">Jours de la semaine personnalisés, tableau de 1-7 (1=lundi, 7=dimanche), valide uniquement pour custom_weekdays</string>
    <string name="agent_tool_add_habit_param_remind_time">Heure de rappel quotidienne, HH:mm (format 24 h), facultatif</string>
    <string name="agent_tool_add_habit_param_note">Note, facultatif</string>
    <string name="agent_tool_add_habit_success">Habitude créée</string>
    <string name="agent_tool_add_habit_failed">Échec de la création de l\'habitude : %1$s</string>
