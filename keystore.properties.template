# keystore.properties 模板（可选）
#
# 不创建本文件也能正常同步与构建：release 签名使用默认占位值，
# debug 构建回退到 AGP 默认 debug 签名，下列第三方服务密钥为空（对应功能不启用）。
# 需要自定义 release 签名或启用对应服务时，复制本文件为 keystore.properties 并填入真实值。
# 注意：keystore.properties 已在 .gitignore 中，请勿提交真实值。

# ---- 发布签名 ----
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=CHANGE_ME
storeFile=/path/to/keystore.jks

# ---- Google Places API key（core/a2ui 位置选择，仅 google flavor 使用） ----
googlePlacesApiKey=

# ---- 各 AI 服务商密钥（注入 BuildConfig，供内置 AI 引擎使用） ----
xiaomiAuthorizationCode=
douBaoAuthorizationCode=
kimiAuthorizationCode=
baiduAuthorizationCode=
openAIAuthorizationCode=
qWenAIAuthorizationCode=
deepSeekAuthorizationCode=
# 注意: 该属性名在代码中即为此拼写 (大写 O)
tencentAuthorizationCOde=

# ---- 和风天气 JWT 凭据 (core/weather; 留空则天气功能关闭) ----
qWeatherReleasePrivateKey=
qWeatherReleaseProjectId=
qWeatherReleaseKeyId=
qWeatherDebugPrivateKey=
qWeatherDebugProjectId=
qWeatherDebugKeyId=

# ---- 后端域名与游客 token (core/r; 留空则不连接任何后端, 云端内容为空) ----
apiBaseUrlDomestic=
apiBaseUrlGoogle=
apiDebugUrlDomestic=
guestAccessToken=
remoteConfigAccessTokenDomestic=
remoteConfigAccessTokenGoogle=
