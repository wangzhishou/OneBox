<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Play 渠道专属 Manifest
    - 与 main/AndroidManifest.xml 合并: 这里只声明差异
    - AGP 会自动把两个 manifest 合并到最终 APK
    - 用 tools:node="remove" 移除主清单中与 Google Play 冲突的条目
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 移除微信客户端可见性 query (海外用户无微信) -->
    <queries tools:node="remove" />

    <!-- 移除 Google Play 严格审查/被拒的权限 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.PROJECT_MEDIA" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- 读取媒体走系统照片选择器, 不需要 READ_EXTERNAL_STORAGE 旧权限 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:node="remove" />
    <!-- google 渠道已接入 AdMob 激励广告(feature/ad-watch), 保留广告 ID 权限 -->

    <application
        android:label="@string/app_launcher_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="false"
        android:usesCleartextTraffic="false"
        tools:replace="android:label, android:networkSecurityConfig, android:requestLegacyExternalStorage, android:usesCleartextTraffic">

        <!--
            App Links: https://www.oneboxable.com/link/* 直接打开 App(与 onebox:// 深链同路由),
            autoVerify 依赖 https://www.oneboxable.com/.well-known/assetlinks.json
            中的 Play App Signing 证书指纹;未验证时退回系统默认打开方式,无负面影响
        -->
        <activity android:name=".AppActivity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.oneboxable.com" />
                <data android:path="/link" />
                <data android:pathPrefix="/link/" />
            </intent-filter>
        </activity>

        <!-- 移除国内 SDK 入口, 海外渠道不暴露 -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            tools:node="remove" />
        <activity
            android:name=".wxapi.WXPayEntryActivity"
            tools:node="remove" />

        <service
            android:name="com.wanbaohe.app.service.FloatingRobotService"
            tools:node="remove" />

        <!--
            AdMob 激励广告(feature/ad-watch), 正式 App ID(发布商 pub-2510840726350411)。
            该 meta-data 必须声明: 新版 GMS SDK 的 MobileAdsInitProvider 在缺失时
            会直接崩溃(IllegalStateException: Missing application ID), 无法延后初始化。
            副作用是 App 启动时 SDK 自动初始化, 但不进广告页不会发起广告请求。
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2510840726350411~8152485979" />

    </application>

</manifest>
